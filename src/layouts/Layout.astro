---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Omnisphere Space Technologies - Full-Stack Space Infrastructure" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="nebula-grid"></div>
    <div class="cosmic-radial"></div>
    <slot />
  </body>
</html>