---
interface Props {
  category: string;
  title: string;
  specs: string[];
  description: string;
}

const { category, title, specs, description } = Astro.props;
---
<div class="p-8 border border-white/10 bg-space-900/60 hover:border-space-gold/50 transition-all group flex flex-col justify-between">
  <div>
    <span class="text-xs font-mono text-space-cyan uppercase tracking-widest">{category}</span>
    <h3 class="text-2xl font-bold mt-2 text-white group-hover:text-space-gold transition-colors">{title}</h3>
    <p class="mt-4 text-sm text-slate-400 leading-relaxed">{description}</p>
  </div>
  <div class="mt-8 pt-6 border-t border-white/5 font-mono text-xs text-slate-400 space-y-2">
    {specs.map((item) => (
      <div class="flex justify-between items-center">
        <span>{item.split(':')[0]}</span>
        <span class="text-white">{item.split(':')[1]}</span>
      </div>
    ))}
  </div>
</div>
